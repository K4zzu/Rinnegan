# Copia a .env y rellena. NO subas .env a git.
# Variables del backend Rinnegan (las lee el servicio `backend` del compose).

# --- IA ---
OPENAI_API_KEY=sk-...                # tu key de OpenAI
OPENAI_MODEL=gpt-4o-mini

# --- Auth ---
JWT_SECRET=                          # genera con: openssl rand -hex 32
JWT_EXPIRE_DAYS=7
INVITE_CODES=cambia-esto,otro-codigo # códigos de invitación para registro
SCANS_PER_DAY=50

# --- Base de datos (persistida en volumen) ---
DB_PATH=/app/data/rinnegan.db

# --- CORS (orígenes del frontend permitidos) ---
CORS_ORIGINS=https://k4zzu.github.io,http://localhost:5173

# --- OSINT (defaults) ---
PHONE_DEFAULT_REGION=
MEDIA_ENABLED=true
MEDIA_MAX_OGIMAGE=5
FACE_ENABLED=false                   # rostros/InsightFace off por ahora (pesado; sub-proyecto D)
